{% trans_default_domain 'contao_default' %}
{% trans_default_domain 'loki' %}

<div class="loki-prompt-button" data-controller="prompt-button-group">
    <button data-id="{{ field.id }}" data-field="{{ widget.name }}" data-object-id="{{ objectId }}" data-prefix="{{ path('contao_backend') }}" type="button" aria-label="{{ 'loki.button.title'|trans({':title': field.parent.title, ':field': widget.label}) }}" title="{{ field.parent.title }}" {{ stimulus_controller('run-single-prompt') }} {{ stimulus_action('run-single-prompt', 'run') }}>{{ field.parent.title }}</button>
</div>